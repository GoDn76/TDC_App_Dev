<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/editWeight"
        android:layout_width="273dp"
        android:layout_height="57dp"
        android:ems="10"
        android:hint="@string/hint_wt"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/editHeightFt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.812" />

    <EditText
        android:id="@+id/editHeightIn"
        android:layout_width="273dp"
        android:layout_height="57dp"
        android:layout_marginBottom="100dp"
        android:ems="10"
        android:hint="@string/hint_htF"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editHeightFt"
        android:layout_width="273dp"
        android:layout_height="57dp"
        android:layout_marginBottom="36dp"
        android:ems="10"
        android:hint="@string/hint_htI"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/editHeightIn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button"
        android:layout_width="168dp"
        android:layout_height="56dp"
        android:layout_marginBottom="52dp"
        android:text="@string/BMI"
        app:layout_constraintBottom_toTopOf="@+id/showResults"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/showResults"
        android:layout_width="234dp"
        android:layout_height="71dp"
        android:layout_marginBottom="152dp"
        android:ems="10"
        android:inputType="number"
        android:text="Result : "
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>